# Study Hub environment
# Copy to .env or export these in your shell.

# DeepSeek API key (required for AI chat, generation and extraction)
DEEPSEEK_API_KEY=

# Optional AI overrides
# STUDY_HUB_AI_BASE_URL=https://api.deepseek.com
# STUDY_HUB_AI_MODEL=deepseek-chat
# STUDY_HUB_AI_API_KEY=
# STUDY_HUB_AI_EXTRACTION_MODEL=deepseek-chat

# Server
# STUDY_HUB_HOST=127.0.0.1
# STUDY_HUB_PORT=1737
# Comma-separated extra allowed Host headers (optional)
# STUDY_HUB_ALLOWED_HOSTS=myhost.local:1737
# Override the automatically generated local API token (optional; it is written to data/.api-token)
# STUDY_HUB_API_TOKEN=

# Data location (keep this on /mnt/Data or /mnt/Vault)
# STUDY_HUB_DATA_DIR=/mnt/Data/app/study-hub/data

# Caelestia scheme file override
# CAELESTIA_SCHEME_PATH=/home/you/.local/state/caelestia/scheme.json

# Launcher config override
# STUDY_HUB_LAUNCHER_CONFIG=/home/you/.config/study-hub/launcher.json
